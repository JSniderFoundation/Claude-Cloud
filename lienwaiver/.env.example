# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/lienwaiver.db

# First staff login, created on first start if no users exist
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Where AP notifications (received waivers, holds) go
AP_NOTIFY_EMAIL=ap@example.com

# Email backend: console | smtp | graph
EMAIL_BACKEND=console
EMAIL_FROM=lienwaivers@example.com
EMAIL_FROM_NAME=Accounts Payable

# smtp backend (Microsoft 365 SMTP AUTH: smtp.office365.com:587, STARTTLS)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=lienwaivers@example.com
SMTP_PASSWORD=

# graph backend (Microsoft 365 app registration with Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Time zone for timestamps in the UI
TIMEZONE=America/New_York

# NetSuite backend: fake | rest
NETSUITE_BACKEND=fake
# rest backend: integration record + access token (token-based authentication)
NETSUITE_ACCOUNT=1234567            # account id, e.g. 1234567 or 1234567_SB1
NETSUITE_CONSUMER_KEY=
NETSUITE_CONSUMER_SECRET=
NETSUITE_TOKEN_ID=
NETSUITE_TOKEN_SECRET=
NETSUITE_PROJECT_SEGMENT=csegnsps_seg_projec   # the Projects custom segment id
NETSUITE_SUBSIDIARY_ID=             # optional: internal id of Foundation Millwork and Stone
NETSUITE_SYNC_START=2026-09-01      # first payment date to pull
NETSUITE_RETAINAGE_MATCH=Retainage  # account name fragment that marks retainage lines
NETSUITE_SYNC_MINUTES=15
# phase 3: set Payment Hold on the vendor's open bills. Needs a checkbox body field with this id on Vendor Bill.
NETSUITE_WRITE_HOLDS=false
NETSUITE_HOLD_FIELD=custbody_lien_waiver_hold

# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8000
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/lienwaiver.db

# First staff login, created on first start if no users exist
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Where AP notifications (received waivers, holds) go
AP_NOTIFY_EMAIL=ap@example.com

# Email backend: console | smtp | graph
EMAIL_BACKEND=console
EMAIL_FROM=lienwaivers@example.com
EMAIL_FROM_NAME=Accounts Payable

# smtp backend (Microsoft 365 SMTP AUTH: smtp.office365.com:587, STARTTLS)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=lienwaivers@example.com
SMTP_PASSWORD=

# graph backend (Microsoft 365 app registration with Mail.Send application permission)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# Time zone for timestamps in the UI
TIMEZONE=America/New_York

# NetSuite backend: fake | rest   (rest is phase 2)
NETSUITE_BACKEND=fake
